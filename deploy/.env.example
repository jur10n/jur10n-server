# Copy to /etc/jur10n/jur10n.env outside the repository.
# Never commit a populated copy. Replace every placeholder before starting.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
MASTER_SECRET=<32-byte-base64url-root-secret>
ADMIN_USERNAME=owner
# Optional for first boot; remove after the first password change.
ADMIN_INITIAL_PASSWORD=<one-time-initial-password>
INITIAL_ADMIN_PASSWORD_FILE=/srv/jur10n/data/initial-admin-password
SQLITE_DATABASE_PATH=/srv/jur10n/data/app.sqlite3
SQLITE_BACKUP_DIR=/srv/jur10n/backups/sqlite
SQLITE_BACKUP_RETENTION_DAYS=14
FILES_ROOT=/srv/jur10n/data/files
DASHBOARD_ORIGIN=https://dashboard.example.com
MIN_FREE_BYTES=268435456
MIN_FREE_INODES=128
MAX_FILE_BYTES=67108864
CLIENT_TIMESTAMP_WINDOW_MS=60000
CLIENT_HEARTBEAT_TIMEOUT_SECONDS=300
